{
  "name": "@embedpdf/core-wasm",
  "private": true,
  "type": "module",
  "description": "Evaluation only: the Rust kernel and plugins (crates/epdf-web) behind the @embedpdf/core surface.",
  "scripts": {
    "build:wasm": "bash ../../crates/epdf-web/scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@embedpdf/core": "workspace:*",
    "@embedpdf/core-geometry": "workspace:*",
    "@embedpdf/engine-core": "workspace:*",
    "@embedpdf/plugin-actions": "workspace:*",
    "@embedpdf/plugin-annotation": "workspace:*",
    "@embedpdf/plugin-commands": "workspace:*",
    "@embedpdf/plugin-form": "workspace:*",
    "@embedpdf/plugin-i18n": "workspace:*",
    "@embedpdf/plugin-interaction": "workspace:*",
    "@embedpdf/plugin-link": "workspace:*",
    "@embedpdf/plugin-measurement": "workspace:*",
    "@embedpdf/plugin-metadata": "workspace:*",
    "@embedpdf/plugin-page-edit": "workspace:*",
    "@embedpdf/plugin-redaction": "workspace:*",
    "@embedpdf/plugin-render": "workspace:*",
    "@embedpdf/plugin-search": "workspace:*",
    "@embedpdf/plugin-selection": "workspace:*",
    "@embedpdf/plugin-shell": "workspace:*",
    "@embedpdf/plugin-signature": "workspace:*",
    "@embedpdf/plugin-stage": "workspace:*",
    "@embedpdf/plugin-stamp": "workspace:*",
    "@embedpdf/plugin-view-manager": "workspace:*"
  },
  "devDependencies": {
    "@embedpdf/engine": "workspace:*",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
