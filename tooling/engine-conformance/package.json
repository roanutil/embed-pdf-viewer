{
  "name": "@embedpdf/tooling-engine-conformance",
  "private": true,
  "type": "module",
  "description": "Generates the frozen cross-language conformance vectors under vectors/. The shipping TypeScript engine is the oracle; the Rust crates are compared against it.",
  "scripts": {
    "vectors": "tsx --conditions=development src/generate-vectors.ts",
    "vectors:check": "tsx --conditions=development src/generate-vectors.ts --check",
    "schema": "tsx --conditions=development src/generate-schema-vectors.ts",
    "schema:check": "tsx --conditions=development src/generate-schema-vectors.ts --check",
    "search": "tsx --conditions=development src/generate-search-vectors.ts",
    "search:check": "tsx --conditions=development src/generate-search-vectors.ts --check",
    "scope": "tsx --conditions=development src/generate-scope-vectors.ts",
    "scope:check": "tsx --conditions=development src/generate-scope-vectors.ts --check",
    "security": "tsx --conditions=development src/generate-security-vectors.ts",
    "security:check": "tsx --conditions=development src/generate-security-vectors.ts --check",
    "render": "tsx --conditions=development src/generate-render-vectors.ts",
    "render:check": "tsx --conditions=development src/generate-render-vectors.ts --check",
    "charmap": "tsx --conditions=development src/generate-charmap-vectors.ts",
    "charmap:check": "tsx --conditions=development src/generate-charmap-vectors.ts --check",
    "metadata": "tsx --conditions=development src/generate-metadata-vectors.ts",
    "metadata:check": "tsx --conditions=development src/generate-metadata-vectors.ts --check",
    "actions": "tsx --conditions=development src/generate-action-vectors.ts",
    "actions:check": "tsx --conditions=development src/generate-action-vectors.ts --check",
    "layout": "tsx --conditions=development src/generate-layout-vectors.ts",
    "layout:check": "tsx --conditions=development src/generate-layout-vectors.ts --check",
    "operations": "tsx src/check-operations.ts",
    "operations:check": "tsx src/check-operations.ts --check",
    "verify:wasm-bridge": "node --experimental-strip-types src/verify-wasm-bridge.mts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@embedpdf/engine": "workspace:*",
    "@embedpdf/engine-core": "workspace:*",
    "@types/node": "^22.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
