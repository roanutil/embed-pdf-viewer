{
  "name": "@embedpdf/tooling-engine-conformance",
  "private": true,
  "type": "module",
  "description": "Generates the frozen cross-language conformance vectors under vectors/. The shipping TypeScript engine is the oracle; the Rust crates are compared against it.",
  "scripts": {
    "vectors": "tsx --conditions=development src/generate-vectors.ts",
    "vectors:check": "tsx --conditions=development src/generate-vectors.ts --check",
    "schema": "tsx --conditions=development src/generate-schema-vectors.ts",
    "schema:check": "tsx --conditions=development src/generate-schema-vectors.ts --check",
    "search": "tsx --conditions=development src/generate-search-vectors.ts",
    "search:check": "tsx --conditions=development src/generate-search-vectors.ts --check",
    "scope": "tsx --conditions=development src/generate-scope-vectors.ts",
    "scope:check": "tsx --conditions=development src/generate-scope-vectors.ts --check",
    "security": "tsx --conditions=development src/generate-security-vectors.ts",
    "security:check": "tsx --conditions=development src/generate-security-vectors.ts --check",
    "render": "tsx --conditions=development src/generate-render-vectors.ts",
    "render:check": "tsx --conditions=development src/generate-render-vectors.ts --check",
    "charmap": "tsx --conditions=development src/generate-charmap-vectors.ts",
    "charmap:check": "tsx --conditions=development src/generate-charmap-vectors.ts --check",
    "metadata": "tsx --conditions=development src/generate-metadata-vectors.ts",
    "metadata:check": "tsx --conditions=development src/generate-metadata-vectors.ts --check",
    "annotation": "tsx --conditions=development src/generate-annotation-vectors.ts",
    "annotation:check": "tsx --conditions=development src/generate-annotation-vectors.ts --check",
    "annotation-read": "tsx --conditions=development src/generate-annotation-read-vectors.ts",
    "annotation-read:check": "tsx --conditions=development src/generate-annotation-read-vectors.ts --check",
    "annotation-appearance": "tsx --conditions=development src/generate-annotation-appearance-vectors.ts",
    "annotation-appearance:check": "tsx --conditions=development src/generate-annotation-appearance-vectors.ts --check",
    "attachments": "tsx --conditions=development src/generate-attachment-vectors.ts",
    "attachments:check": "tsx --conditions=development src/generate-attachment-vectors.ts --check",
    "forms": "tsx --conditions=development src/generate-form-vectors.ts",
    "forms:check": "tsx --conditions=development src/generate-form-vectors.ts --check",
    "piece-info": "tsx --conditions=development src/generate-piece-info-vectors.ts",
    "piece-info:check": "tsx --conditions=development src/generate-piece-info-vectors.ts --check",
    "extract": "tsx --conditions=development src/generate-extract-vectors.ts",
    "extract:check": "tsx --conditions=development src/generate-extract-vectors.ts --check",
    "save": "tsx --conditions=development src/generate-save-vectors.ts",
    "save:check": "tsx --conditions=development src/generate-save-vectors.ts --check",
    "annotation-write": "tsx --conditions=development src/generate-annotation-write-vectors.ts",
    "annotation-write:check": "tsx --conditions=development src/generate-annotation-write-vectors.ts --check",
    "annotation-create": "tsx --conditions=development src/generate-annotation-create-vectors.ts",
    "annotation-create:check": "tsx --conditions=development src/generate-annotation-create-vectors.ts --check",
    "annotation-delete": "tsx --conditions=development src/generate-annotation-delete-vectors.ts",
    "annotation-delete:check": "tsx --conditions=development src/generate-annotation-delete-vectors.ts --check",
    "annotation-update": "tsx --conditions=development src/generate-annotation-update-vectors.ts",
    "annotation-update:check": "tsx --conditions=development src/generate-annotation-update-vectors.ts --check",
    "annotation-move": "tsx --conditions=development src/generate-annotation-move-vectors.ts",
    "annotation-move:check": "tsx --conditions=development src/generate-annotation-move-vectors.ts --check",
    "actions": "tsx --conditions=development src/generate-action-vectors.ts",
    "actions:check": "tsx --conditions=development src/generate-action-vectors.ts --check",
    "layout": "tsx --conditions=development src/generate-layout-vectors.ts",
    "layout:check": "tsx --conditions=development src/generate-layout-vectors.ts --check",
    "operations": "tsx src/check-operations.ts",
    "operations:check": "tsx src/check-operations.ts --check",
    "verify:wasm-bridge": "node --experimental-strip-types src/verify-wasm-bridge.mts",
    "typecheck": "tsc --noEmit",
    "form-write": "tsx --conditions=development src/generate-form-write-vectors.ts",
    "form-write:check": "tsx --conditions=development src/generate-form-write-vectors.ts --check",
    "form-field": "tsx --conditions=development src/generate-form-field-vectors.ts",
    "form-field:check": "tsx --conditions=development src/generate-form-field-vectors.ts --check",
    "pages-mutate": "tsx --conditions=development src/generate-pages-mutate-vectors.ts",
    "pages-mutate:check": "tsx --conditions=development src/generate-pages-mutate-vectors.ts --check"
  },
  "devDependencies": {
    "@embedpdf/engine": "workspace:*",
    "@embedpdf/engine-core": "workspace:*",
    "@types/node": "^22.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
