  {"name":"a-rejection-does-not-stop-the-batch","covers":"Preflight refused the first and nothing was written for it, so the second still runs. Only a failed write stops a batch.","effects":[{"kind":"setValue","ref":{"kind":"objectNumber","fieldObjectNumber":4},"value":{"type":"toggle","state":"Yes"}},{"kind":"setValue","ref":{"kind":"objectNumber","fieldObjectNumber":4},"value":{"type":"text","value":"Ada"}}],"results":[{"index":0,"status":"rejected","fields":[],"changedWidgets":[],"errorCode":"InvalidArg"},{"index":1,"status":"applied","fields":[{"fieldObjectNumber":4,"name":"billing.name","family":"text","value":"Ada","selectedValues":null,"valueEntry":{"kind":"scalar","value":"Ada"}}],"changedWidgets":[{"ref":{"kind":"objectNumber","page":{"kind":"objectNumber","pageObjectNumber":3},"annotObjectNumber":4},"annotObjectNumber":4,"page":{"kind":"objectNumber","pageObjectNumber":3}}]}],"changedWidgets":[{"ref":{"kind":"objectNumber","page":{"kind":"objectNumber","pageObjectNumber":3},"annotObjectNumber":4},"annotObjectNumber":4,"page":{"kind":"objectNumber","pageObjectNumber":3}}],"wrote":true},
