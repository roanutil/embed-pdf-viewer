  {"name":"writing-the-same-value-is-unchanged","covers":"Written once then written again. The second is a no-op, and reporting it as applied would bump the version for a script that changed nothing.","effects":[{"kind":"setValue","ref":{"kind":"objectNumber","fieldObjectNumber":4},"value":{"type":"text","value":"Ada"}},{"kind":"setValue","ref":{"kind":"objectNumber","fieldObjectNumber":4},"value":{"type":"text","value":"Ada"}}],"results":[{"index":0,"status":"applied","fields":[{"fieldObjectNumber":4,"name":"billing.name","family":"text","value":"Ada","selectedValues":null,"valueEntry":{"kind":"scalar","value":"Ada"}}],"changedWidgets":[{"ref":{"kind":"objectNumber","page":{"kind":"objectNumber","pageObjectNumber":3},"annotObjectNumber":4},"annotObjectNumber":4,"page":{"kind":"objectNumber","pageObjectNumber":3}}]},{"index":1,"status":"unchanged","fields":[{"fieldObjectNumber":4,"name":"billing.name","family":"text","value":"Ada","selectedValues":null,"valueEntry":{"kind":"scalar","value":"Ada"}}],"changedWidgets":[]}],"changedWidgets":[{"ref":{"kind":"objectNumber","page":{"kind":"objectNumber","pageObjectNumber":3},"annotObjectNumber":4},"annotObjectNumber":4,"page":{"kind":"objectNumber","pageObjectNumber":3}}],"wrote":true},
