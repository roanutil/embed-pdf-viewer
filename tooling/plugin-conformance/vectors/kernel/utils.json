    {
      "name": "hook-dispose",
      "covers": "After dispose nothing is delivered, on() returns an inert unsubscribe, and unsubscribing a pre-dispose listener is harmless.",
      "fn": "eventHookScript",
      "args": [
        [
          {
            "op": "on",
            "id": "a"
          },
          {
            "op": "dispose"
          },
          {
            "op": "emit",
            "event": 1
          },
          {
            "op": "on",
            "id": "b"
          },
          {
            "op": "emit",
            "event": 2
          },
          {
            "op": "off",
            "id": "a"
          },
          {
            "op": "off",
            "id": "b"
          }
        ],
        true
      ],
      "outcome": {
        "returned": [
          "disposed",
          {
            "emit": 1
          },
          {
            "emit": 2
          }
        ]
      }
    },
    {
      "name": "hook-signal-ends-a-subscription",
      "covers": "A listener subscribed with a signal is removed when it aborts; one subscribed with a pre-aborted signal never registers.",
      "fn": "eventHookScript",
      "args": [
        [
          {
            "op": "onSignal",
            "id": "a",
            "signal": "s"
          },
          {
            "op": "on",
            "id": "b"
          },
          {
            "op": "emit",
            "event": 1
          },
          {
            "op": "abort",
            "signal": "s"
          },
          {
            "op": "emit",
            "event": 2
          },
          {
            "op": "onSignal",
            "id": "c",
            "signal": "s"
          },
          {
            "op": "emit",
            "event": 3
          },
          {
            "op": "off",
            "id": "c"
          }
        ],
        true
      ],
      "outcome": {
        "returned": [
          {
            "emit": 1
          },
          {
            "id": "a",
            "event": 1
          },
          {
            "id": "b",
            "event": 1
          },
          {
            "aborted": "s"
          },
          {
            "emit": 2
          },
          {
            "id": "b",
            "event": 2
          },
          {
            "emit": 3
          },
          {
            "id": "b",
            "event": 3
          }
        ]
      }
    },
    {
      "name": "hook-signal-after-dispose",
      "covers": "After dispose a subscription with a live signal is inert, and aborting that signal later is harmless.",
      "fn": "eventHookScript",
      "args": [
        [
          {
            "op": "dispose"
          },
          {
            "op": "onSignal",
            "id": "a",
            "signal": "s"
          },
          {
            "op": "abort",
            "signal": "s"
          },
          {
            "op": "emit",
            "event": 1
          }
        ],
        true
      ],
      "outcome": {
        "returned": [
          "disposed",
          {
            "aborted": "s"
          },
          {
            "emit": 1
          }
        ]
      }
    },
