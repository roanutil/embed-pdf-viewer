commit 98e5c270c6a7fb3446523fecbbb73bfee9ef1971
Author: Bob Singor <bob@singor.com>
Date:   Sat Oct 10 23:20:13 2026 +0300

    Forms engine round: prediction helpers, widget looks, field rights; applyEffects removed

    - engine-core: the form rules as pure functions (fieldValueWriteOf, fieldAfterValue,
      fieldAfterReset, widgetsAfterDisplay, formFieldOfDraft, formFieldAfter,
      widgetAfterPatch), checked by runFormPredictionConformance on both engines
    - widgets: underline border, dashArray, checkStyle; form writes report redrawnWidgets
    - doc.security.fieldRights() on both engines
    - doc.forms.applyEffects, FormsEffectsApplier, forms.effectsApplied and the server's
      form/effects route removed: a script run's effects are one doc.apply change
    - a reset at defaults or a display that changes no widget records no undo step
    - form plugin writes script results through doc.apply; the actions form sink
      answers { status, error? }; forms.setDisplay ops take no expect
    - contract, TS SDK, API snapshots and docs regenerated

diff --git a/packages/plugin/actions/src/dispatch/run.ts b/packages/plugin/actions/src/dispatch/run.ts
index c4a2359ae..895085fe4 100644
--- a/packages/plugin/actions/src/dispatch/run.ts
+++ b/packages/plugin/actions/src/dispatch/run.ts
@@ -143,11 +143,8 @@ export function createRunner(
         const result = await ports.formCommitSink(
           fieldRefs.map((ref) => ({ kind: 'setDisplay', ref, display })),
         );
-        const firstFailure = result.results.find(
-          (entry) => entry.status === 'failed' || entry.status === 'rejected',
-        );
-        if (firstFailure) {
-          failedDetail = firstFailure.error?.message ?? firstFailure.status;
+        if (result.status === 'failed') {
+          failedDetail = result.error ?? 'failed';
           diagnoseHide({ code: 'executor-failed', message: `hide: ${failedDetail}` });
         }
       }
