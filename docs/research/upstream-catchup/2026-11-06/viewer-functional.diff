diff --git a/packages/engine/core/src/wire/apiVersion.ts b/packages/engine/core/src/wire/apiVersion.ts
new file mode 100644
index 000000000..aa7619f3a
--- /dev/null
+++ b/packages/engine/core/src/wire/apiVersion.ts
@@ -0,0 +1,31 @@
+import { version } from '../../package.json';
+
+/** An API version: the major and minor of a release. */
+export interface ApiVersion {
+  major: number;
+  minor: number;
+}
+
+/**
+ * Reads `<major>.<minor>` (`EmbedPDF-Version`, `EmbedPDF-Server-Version`).
+ * Returns `null` for anything else, a patch number included.
+ */
+export function parseApiVersion(raw: string): ApiVersion | null {
+  const match = /^(0|[1-9]\d*)\.(0|[1-9]\d*)$/.exec(raw);
+  return match ? { major: Number(match[1]), minor: Number(match[2]) } : null;
+}
+
+/** The API version of a package version: `3.0.0-next.22` is `3.0`. */
+export function apiVersionOf(packageVersion: string): string {
+  const match = /^(0|[1-9]\d*)\.(0|[1-9]\d*)\.\d+/.exec(packageVersion);
+  if (!match) throw new Error(`not a package version: ${packageVersion}`);
+  return `${match[1]}.${match[2]}`;
+}
+
+/**
+ * The API version this release speaks: what a client sends as
+ * `EmbedPDF-Version` and a server answers as `EmbedPDF-Server-Version`
+ * (`docs/conventions/api-evolution.md`). The engine, viewer, server and SDK
+ * packages release together, so they all speak this one.
+ */
+export const API_VERSION: string = apiVersionOf(version);
diff --git a/packages/engine/core/src/wire/cachedReads.ts b/packages/engine/core/src/wire/cachedReads.ts
new file mode 100644
index 000000000..12403bc4c
--- /dev/null
+++ b/packages/engine/core/src/wire/cachedReads.ts
@@ -0,0 +1,92 @@
+import { z } from 'zod';
+import { EngineError } from '../errors/EngineError';
+import { EngineErrorCode } from '../errors/EngineErrorCode';
+
+/**
+ * The kinds of cached read (`…@token`), one per URL family. Besides its
+ * versions and request, every cached read's token names the kind's engine
+ * value, copied from `/head`, and the shape the client reads
+ * (`docs/conventions/api-evolution.md`).
+ */
+export const CACHED_READ_KINDS = [
+  'manifest',
+  'layout',
+  'text',
+  'geometry',
+  'render',
+  'annotationAppearances',
+  'widgetAppearances',
+  'annotations',
+  'annotationsAll',
+  'annotationsExport',
+  'form',
+  'formExport',
+  'metadata',
+  'outline',
+  'attachments',
+  'actions',
+  'fonts',
+  'search',
+  'signatures',
+  'analysis',
+  'download',
+] as const;
+
+export type CachedReadKind = (typeof CACHED_READ_KINDS)[number];
+
+/**
+ * A server's engine value for each kind: what it computes that kind with,
+ * besides the document. Opaque to the client, which copies it into tokens.
+ */
+export type EngineValues = Readonly<Record<string, string>>;
+
+/** `/head`'s `engine`: tolerant of kinds this code doesn't know. */
+export const EngineValuesSchema = z.record(z.string(), z.string().regex(/^[A-Za-z0-9.-]+$/));
+
+/**
+ * The newest shape of each kind this code reads and answers. A client asks
+ * for it; a server answers every shape from 1 up to its own.
+ */
+export const SHAPES: Readonly<Record<CachedReadKind, number>> = {
+  manifest: 1,
+  layout: 1,
+  text: 1,
+  geometry: 1,
+  render: 1,
+  annotationAppearances: 1,
+  widgetAppearances: 1,
+  annotations: 1,
+  annotationsAll: 1,
+  annotationsExport: 1,
+  form: 1,
+  formExport: 1,
+  metadata: 1,
+  outline: 1,
+  attachments: 1,
+  actions: 1,
+  fonts: 1,
+  search: 1,
+  signatures: 1,
+  analysis: 1,
+  download: 1,
+};
+
+/** What a cached read's token carries besides its versions and request. */
+export interface TokenPin {
+  /** The kind's engine value, as `/head` gave it. */
+  engine: string;
+  /** The shape the client reads. */
+  shape: number;
+}
+
+/** The pin a client puts in a `kind` token: the server's engine value and this code's shape. */
+export function tokenPinOf(kind: CachedReadKind, engine: EngineValues): TokenPin {
+  const value = engine[kind];
+  if (value === undefined) {
+    throw new EngineError(
+      EngineErrorCode.WireFormat,
+      `the server gave no engine value for ${kind}`,
+    );
+  }
+  return { engine: value, shape: SHAPES[kind] };
+}
