plugins {
    id("com.android.library")
}

android {
    namespace = "com.embedpdf"
    compileSdk = 36

    defaultConfig {
        // Matches API in build-aar.sh. A lower floor here than the one the .so
        // was linked against would ship a library that fails to resolve
        // symbols on old devices rather than refusing to install.
        minSdk = 24
        testInstrumentationRunner = "androidx.test.runner.AndroidJUnitRunner"
        ndk {
            abiFilters += listOf("arm64-v8a", "x86_64")
        }
    }

    // The .so files and the generated Kotlin are produced by build-aar.sh and
    // are not in the repository, so the source sets point at where it puts
    // them rather than at the Gradle defaults.
    sourceSets {
        getByName("main") {
            kotlin.srcDir("src/main/kotlin")
            jniLibs.srcDir("src/main/jniLibs")
        }
        getByName("androidTest") {
            kotlin.srcDir("src/androidTest/kotlin")
            assets.srcDir("src/androidTest/assets")
        }
    }

    packaging {
        jniLibs {
// swift-tools-version: 6.2

import PackageDescription

// Where the engine comes from. Written by the engine release scripts: the
// release tag on embed-pdf-runtime and the SHA-256 of its
// EmbedPDFBindings.xcframework.zip. Both are "unpublished" until the first
// publish.
let engineRelease = "apple-engine-3816be131b65bdee"
let engineChecksum = "88cfb206b6d3fd74e017062411bbd6a5133616882e52df299754aa9487c0a116"

let package = Package(
  name: "EmbedPDF",
  platforms: [
    .iOS(.v17),
  ],
  products: [
    .library(name: "EmbedPDF", targets: ["EmbedPDF"]),
    .library(name: "EmbedPDFUI", targets: ["EmbedPDFUI"]),
  ],
  dependencies: [
    .package(url: "https://github.com/pointfreeco/swift-custom-dump", from: "1.3.0"),
  ],
  targets: [
    .binaryTarget(name: "EmbedPDFFFI", path: "EmbedPDFFFI.xcframework"),
    .target(
      name: "EmbedPDFBindings",
      dependencies: [
        "EmbedPDFFFI",
      ],
      swiftSettings: [
        .swiftLanguageMode(.v5),
      ],
      linkerSettings: [
        .linkedLibrary("c++"),
        .linkedFramework("CoreFoundation"),
        .linkedFramework("CoreGraphics"),
      ]
    ),
    .target(
      name: "EmbedPDF",
      dependencies: [
        "EmbedPDFBindings",
      ]
    ),
    .target(
      name: "EmbedPDFUI",
      dependencies: [
        "EmbedPDF",
      ]
    ),
    .testTarget(
      name: "EmbedPDFBindingsSmokeTests",
      dependencies: [
