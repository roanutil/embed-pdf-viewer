}

impl From<PageRef> for PageArg {
    fn from(page: PageRef) -> Self {
        PageArg::Ref(page)
    }
}

impl From<usize> for PageArg {
    fn from(index: usize) -> Self {
        PageArg::Index(index as f64)
    }
}

impl Serialize for PageArg {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        match self {
            PageArg::Ref(page) => page.to_json().serialize(s),
            PageArg::Index(index) => index.serialize(s),
        }
    }
}

// ── the raster vocabulary ─────────────────────────────────────────────────────

/// `PageLayerOptions`: what a picture draws beside the page content. An
/// option left out draws what the user may read: the annotations with
/// `doc.annotate.read`, the form fields with `doc.forms.read`, and no form
/// fields when `include_annotations` is `false`. `true` for something the
/// user may not read is refused (`permission-denied`).
#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
pub struct PageLayerOptions {
    /// Draw the annotations (form fields' widgets excepted).
    pub include_annotations: Option<bool>,
    /// Draw the form fields, each in the state its field shows.
    pub include_form_fields: Option<bool>,
}

/// `PageImage`: an encoded page image.
pub type PageImage = PageImageHandle;

/// `RenderPageOptions`.
#[derive(Clone, Default)]
pub struct RenderPageOptions {
    /// Exact output width in device pixels (height keeps the aspect).
    pub width: Option<f64>,
    /// Device pixels per PDF point; ignored when `width` is given. `None` is 1.
    pub scale: Option<f64>,
    pub layers: PageLayerOptions,
    /// Per-call encode overrides; default to the plugin's strategy.
    pub format: Option<RenderFormat>,
    pub quality: Option<f64>,
    pub signal: Option<AbortSignal>,
}

/// `RenderThumbnailOptions`: the page's thumbnail is the whole page at the
/// engine's thumbnail size, so it takes no size.
#[derive(Clone, Default)]
pub struct RenderThumbnailOptions {
    pub layers: PageLayerOptions,
    /// Per-call encode overrides; default to the plugin's strategy.
    pub format: Option<RenderFormat>,
    pub quality: Option<f64>,
    pub signal: Option<AbortSignal>,
}

/// `RenderPagesOptions`: a batch's per-page options and its pool size.
#[derive(Clone, Default)]
pub struct RenderPagesOptions {
    pub page: RenderPageOptions,
    /// Renders in flight at once; `None` is 4, and anything below 1 is 1.
    pub concurrency: Option<f64>,
}

/// `PageRender`: one entry of a batch render.
#[derive(Clone, Debug, PartialEq, Serialize)]
pub struct PageRender {
    #[serde(serialize_with = "ser_page")]
    pub page: PageRef,
    pub image: PageImage,
}

/// One failed entry of a batch render: the page as it was given, and why.
#[derive(Clone, Debug, PartialEq, Serialize)]
pub struct PageRenderFailure {
    #[serde(rename = "ref")]
    pub page: PageArg,
    pub error: PluginErrorInfo,
}

/// `BatchResult<PageRender, PageRef | number>`. Render batches skip
pub struct RenderedImage {
    pub width: u32,
    pub height: u32,
    /// Bytes per row. At least `width * 4`; address rows by it.
    pub stride: u32,
    /// Device pixels per PDF point across the page's width: `width` over
    /// the page's width in points.
    pub scale: f64,
    pub format: RenderPixelFormat,
    /// `stride * height` bytes.
    pub pixels: Vec<u8>,
}

/// `RenderPageOptions`, without the encode overrides (`format`, `quality`):
/// a native raster is raw pixels, never encoded.
#[derive(Clone, Copy, Debug, Default, PartialEq, uniffi::Record)]
pub struct RenderPageOptions {
    /// Exact output width in device pixels; the height keeps the aspect.
    #[uniffi(default = None)]
    pub width: Option<f64>,
    /// Device pixels per PDF point; ignored when `width` is given. `None`
    /// is 1.
    #[uniffi(default = None)]
    pub scale: Option<f64>,
    /// Draw the annotations; `None` draws them when the session may read
    /// them (`doc.annotate.read`).
    #[uniffi(default = None)]
    pub include_annotations: Option<bool>,
    /// Draw the form fields; `None` draws them when the session may read
    /// them (`doc.forms.read`) and annotations are not turned off.
    #[uniffi(default = None)]
    pub include_form_fields: Option<bool>,
}

fn layers(
    include_annotations: Option<bool>,
    include_form_fields: Option<bool>,
) -> PageLayerOptions {
    PageLayerOptions { include_annotations, include_form_fields }
}

/// The base plane's render points: the exact demand, or a ladder of widths.
#[derive(Clone, Debug, PartialEq, uniffi::Enum)]
pub enum RenderQuantize {
    Exact,
    Ladder { widths: Vec<f64> },
}

/// `FullPageOptions`: the base plane's pixel budget and render points.
#[derive(Clone, Debug, Default, PartialEq, uniffi::Record)]
pub struct RenderFullPageOptions {
    /// `None` is 640 device pixels.
    #[uniffi(default = None)]
pub struct StageSettings {
    pub flow: FlowMode,
    pub layout: LayoutKind,
    pub spread: SpreadMode,
    pub sizing: SizingMode,
    pub columns: GridColumns,
    pub bounded: bool,
    pub padding: f64,
    pub gap: Gap,
    pub page_frame: PageFrame,
    pub direction: Direction,
    pub fit_align: Alignment,
    pub arrival_align: ArrivalAlignment,
    pub zoom_align: AlignmentValue,
    pub anchor_align: AlignmentValue,
    pub view_rotation: PageRotation,
    pub zoom: ZoomSpec,
    /// The zoom range this view allows, as levels like `camera.zoom` (1 is
    /// 100%). Every zoom stays inside it: the buttons, a pinch or wheel,
    /// `zoom_to`, a reveal, and the fit modes, which stop at a limit rather
    /// than fit. A marquee box is the exception: it clamps only to 0.05 to
    /// 64, as the TypeScript's `zoom-drag.ts` does. Within 0.05 to 64; a
    /// `min_zoom` above `max_zoom` counts as `max_zoom`.
    pub min_zoom: f64,
    /// See [`StageSettings::min_zoom`].
    pub max_zoom: f64,
    pub scroll_behavior: ScrollBehaviorKind,
    /// Whether this view's pointer input reaches the interaction hub.
    pub interaction: bool,
    /// With `interaction`: a drag between pages pans whatever the tool.
    pub pan_fallback: bool,
    /// Whether a pinch or a zoom wheel zooms this view.
    pub zoom_gestures: bool,
    /// The look of the box the `zoom` tool drags. A color left `None`
    /// follows the viewer's accent.
    pub zoom_box: ZoomBoxLook,
    pub view_units_per_point: f64,
}

/// The colors of the zoom tool's box: see [`StageSettings::zoom_box`].
#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]
pub struct ZoomBoxLook {
    /// Inside the box; `None` (`null`) is the viewer's accent at 8%.
    pub fill: Option<String>,
    /// Its dashed edge; `None` (`null`) is the viewer's accent.
    pub stroke: Option<String>,
}

