          "110 /// snapshot.",
          "111 pub fn read_document_faces(",
          "112     document: &pdfium::Document,",
          "113 ) -> Result<Vec<DocumentFaceFacts>, EngineError> {",
          "114     let faces = document.font_faces().map_err(super::engine_error)?.ok_or_else(|| {",
          "115         EngineError::with_message(EngineErrorCode::Unknown, \"EPDFFontFaces_Load failed\")",
          "116     })?;",
          "117     Ok(faces",
          "118         .into_iter()",
          "119         .map(|face| DocumentFaceFacts {",
          "120             family_name: face.family_name.unwrap_or_default(),",
          "121             weight: face.weight,",
          "122             italic: face.italic,",
          "123             programs: face.programs.into_iter().map(program_facts).collect(),",
          "124         })",
          "125         .collect())",
          "126 }",
          "127 ",
          "128 /// `programFacts`: one program's facts, named as the wire names them.",
          "129 fn program_facts(program: pdfium::DocumentFontProgram) -> FontProgramFacts {",
          "130     let (ascent, descent) = thousandths(program.metrics);",
          "131     FontProgramFacts {",
          "132         object_number: program.object_number,",
          "133         format: FontFormat::of_program(program.format),",
          "134         embedded: match program.embedding {",
          "135             Some(pdfium::FontEmbedding::Whole) => Embedded::Whole,",
          "136             Some(pdfium::FontEmbedding::Subset) => Embedded::Subset,",
          "137             _ => Embedded::None,",
          "138         },",
          "139         post_script_name: program.postscript_name.filter(|name| !name.is_empty()),",
          "140         permission: ProgramPermission::from_code(program.embedding_permission),",
          "141         maps_unicode: program.maps_unicode,",
          "142         sha256: program.sha256.map(|hash| hex(&hash)),",
          "143         display_sha256: program.display_sha256.map(|hash| hex(&hash)),",
          "144         ascent,",
          "145         descent,",
          "146     }",
          "147 }",
          "148 ",
