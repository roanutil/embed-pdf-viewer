          "172 /// write would name, when new text can be written in it), or a family.",
          "173 fn face_of_run(run: &FontResolveRun, facts: &FontListFacts, fonts: &FontRegistry) -> RunFace {",
          "174     let name = match run {",
          "175         FontResolveRun::Face { family, weight, italic, .. } => {",
          "176             return RunFace {",
          "177                 family: family.clone(),",
          "178                 weight: *weight,",
          "179                 italic: *italic,",
