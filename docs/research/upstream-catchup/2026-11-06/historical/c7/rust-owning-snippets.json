          "216 pub fn resolve(",
          "217     owned: &OwnedDocument,",
          "218     fonts: &FontRegistry,",
          "219     annotation: Option<&AnnotationRef>,",
          "220     runs: &[FontResolveRun],",
          "221     facts: &FontListFacts,",
