{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local native package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "version",
    "source",
    "runtimeFork",
    "runtimeManifest",
    "fontManifest",
    "abi",
    "rids",
    "files",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packageId": {
      "const": "EmbedPDF.Engine"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "dirty"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "diffSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "dirty": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "diffSha256"
            ]
          }
        }
      ]
    },
    "runtimeFork": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "runtimeManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "fontManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "abi": {
      "const": 1
    },
    "rids": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linux-x64",
        "linux-arm64",
        "osx-arm64",
        "osx-x64",
        "win-x64"
      ],
      "properties": {
        "linux-x64": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "PACKED_UNVALIDATED",
                "VALIDATED",
                "UNVALIDATED"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "linux-arm64": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "PACKED_UNVALIDATED",
                "VALIDATED",
                "UNVALIDATED"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "osx-arm64": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "PACKED_UNVALIDATED",
                "VALIDATED",
                "UNVALIDATED"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "osx-x64": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "PACKED_UNVALIDATED",
                "VALIDATED",
                "UNVALIDATED"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "win-x64": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "PACKED_UNVALIDATED",
                "VALIDATED",
                "UNVALIDATED"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
